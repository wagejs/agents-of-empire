{
  "name": "agents-of-empire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A 3D colony sim where every coding-agent thread on your machine is a little astronaut building something.",
  "license": "MIT",
  "author": "Muhammad Wage Juli Saputra",
  "homepage": "https://github.com/wagejs/agents-of-empire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagejs/agents-of-empire.git"
  },
  "bugs": {
    "url": "https://github.com/wagejs/agents-of-empire/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "share": "node tools/share.mjs",
    "app": "npm run build --silent && electron ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@mdi/js": "^7.4.47",
    "highlight.js": "^11.11.1",
    "three": "^0.185.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "electron": "^44.7.2",
    "vite": "^7.1.0"
  },
  "main": "electron/main.mjs"
}
